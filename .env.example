# Secptile — environment variables (copy to .env.local and fill in real values)
# Never commit .env.local or any real secret.

# ---------------------------------------------------------------------------
# OpenCode (Phase 1) — Secptile talks to OpenCode through the `opencode` CLI
# (`opencode run --format json`), so the CLI binary must be on PATH.
# A background server/service is NOT required; see OPENCODE_SERVER_URL if you
# want to attach to one anyway.
# ---------------------------------------------------------------------------

# Model used for journal drafting/questions ("provider/model").
OPENCODE_MODEL="opencode/big-pickle"

# Isolated working directory for journal sessions (created if missing).
# Must NOT be your repos — OpenCode agents have tool access inside it.
# OPENCODE_WORKSPACE_DIR="$HOME/.secptile/workspace"

# Optional: connect run calls to a specific headless server instead of the
# default background service (e.g. one started with `opencode serve --port 4096`).
# OPENCODE_SERVER_URL=""

# Optional overrides: CLI binary path, per-turn timeout (ms, 1000–900000).
# OPENCODE_BIN="opencode"
# OPENCODE_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Speech-to-text (Phase 2) — local whisper.cpp / faster-whisper HTTP endpoint
# ---------------------------------------------------------------------------
WHISPER_API_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# Blog storage (Phase 4) — approved posts are saved to a local SQLite database
# (node:sqlite, zero dependencies). The mandatory cover photo's bytes are
# stored in the same DB; nothing is committed or pushed to any repo anymore.
# ---------------------------------------------------------------------------
# Where the database file (blog.db) lives. Created if missing.
# SECPTILE_BLOG_DIR="$HOME/.secptile/blog"

# Where day history records are written (default ~/.secptile/history).
# SECPTILE_HISTORY_DIR="$HOME/.secptile/history"

# ---------------------------------------------------------------------------
# LinkedIn publishing (Phase 5) — official LinkedIn API (OAuth 2.0,
# w_member_social scope). Create the app at https://www.linkedin.com/developers
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# Rest headers for the Posts API: Linkedin-Version is YYYYMM of the current
# docs version (li-lms-2026-10 → "202610"). Optional override.
# LINKEDIN_API_VERSION="202610"

# Where the OAuth token record is stored (default ~/.secptile/linkedin.json,
# mode 0600, outside any repo — never committed).
# LINKEDIN_TOKEN_FILE="$HOME/.secptile/linkedin.json"

# ---------------------------------------------------------------------------
# Desktop assistant (Phase 6) — local daemon (daemon/) talks to this app over
# localhost with a shared secret. Generate one: `openssl rand -hex 32`
# ---------------------------------------------------------------------------
SECPTILE_ASSISTANT_SECRET=""

# ---------------------------------------------------------------------------
# Blog feedback (Phase 4b) — review pending comments of the portfolio blog.
# The portfolio blog stores comments in a Supabase project; new ones arrive
# with approved=false. Secptile acts as the reviewer via the server-side
# service_role key (bypasses RLS). NEVER commit the real key.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# App port for the systemd app unit (start with: next start -p 3100).
# PORT="3100"

# ---------------------------------------------------------------------------
# E-mail (Phase 7a) — Gmail via the official Gmail API, READ-ONLY.
# Create at https://console.cloud.google.com :
#   1. Enable "Gmail API" for the project (APIs & Services → Library).
#   2. OAuth consent screen: External; publish it ("In production" — Testing
#      status expires refresh tokens after 7 days; production, single personal
#      use, only shows an "unverified app" screen you accept once).
#   3. Credentials → Create client → Web application; authorized redirect URI:
#      http://localhost:3100/api/mail/google/callback
#      (change together with GOOGLE_REDIRECT_URI if the app port changes).
# Requested scope (hardcoded minimum, read-only): gmail.readonly.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Override only if you register a different redirect URI on the Google client:
# GOOGLE_REDIRECT_URI="http://localhost:3100/api/mail/google/callback"

# Encrypts mail OAuth tokens at rest (~/.secptile/mail.json, mode 0600).
# Generate once:  openssl rand -hex 32   — rotating it logs accounts out
# (the store fails closed and offers Reconnect).
MAIL_ENCRYPTION_KEY=""
