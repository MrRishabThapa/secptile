[Unit]
Description=Secptile transcription (whisper.cpp server, localhost only)
After=default.target

[Service]
Type=simple
# Model lives outside the repo (never commit model files).
# base.en took about 3.5 s per turn here, against 12 s for small, and uses far
# less memory. It only understands English.
ExecStart=/usr/bin/whisper-server -m %h/.secptile/models/ggml-base.en.bin --host 127.0.0.1 --port 8080 --inference-path /inference --convert -t 4
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
