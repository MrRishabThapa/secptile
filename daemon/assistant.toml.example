# Secptile desktop assistant configuration (Phase 6).
# Copy to ~/.secptile/assistant.toml (install.sh does this) and edit there.
# Never commit your real copy: it can carry the shared secret.

[app]
base_url = "http://localhost:3100"
transcribe_path = "/api/transcribe"          # Phase 2 whisper proxy, reused as-is
status_path = "/api/assistant/status"        # daemon -> UI status events
transcript_path = "/api/assistant/transcript" # journal forwards land here
tts_path = "/api/tts"                        # Qwen speech, streamed through the app
# Shared secret required on every daemon request. Leave "" to read it from the
# SECPTILE_ASSISTANT_SECRET environment variable instead (recommended).
secret = ""

[wake]
# "whisper": a small local whisper server listens for the phrase. No training.
# "model": trained livekit-wakeword models. Faster and lighter, but training
# needs a CUDA GPU or Apple silicon.
engine = "whisper"
whisper_url = "http://127.0.0.1:8081"        # secptile-whisper-wake.service
max_seconds = 4.0                            # longest clip checked for the phrase
end_seconds = 0.5                            # pause that ends a wake check
# Only used by engine = "model":
models = [
    "~/.secptile/assistant/models/hey-secptile.onnx",
    "~/.secptile/assistant/models/hey-secp.onnx",
]
threshold = 0.5

[capture]
sample_rate = 16000
# PipeWire source. Falls back to the default mic if it isn't running.
source = "secptile_echo_cancel"
vad_model = "~/.secptile/assistant/models/silero_vad.onnx"
vad_threshold = 0.5          # speech score from 0 to 1
max_seconds = 300            # hard stop even if you keep talking
lead_in_seconds = 0.6        # audio kept from just before speech starts
end_of_turn_seconds = 2.0    # pause that means you've finished your turn

[conversation]
barge_in = true              # talk over Secptile to interrupt it
barge_threshold = 0.7        # raise this if speakers cause false interruptions
barge_min_seconds = 0.24     # how long you must talk before it stops
follow_up_seconds = 8.0      # how long it waits for an answer without a wake phrase
poll_seconds = 0.4           # how often it checks the app for text to speak

[feedback]
# Played with `paplay` (PipeWire) — a short chime after the wake phrase.
chime = "~/.secptile/assistant/chime.wav"

[window]
# Matched against the window class only. Titles aren't safe here: "secptile"
# in a title also matches your editor and terminals, and "close system" would
# close them.
match = ["brave-localhost"]
# Runs when no matching window exists. It must open an app window, because a
# normal browser tab has a different class and would never match.
launch_command = "brave --app=http://localhost:3100"

[misc]
# Touched by `secptile-mute`; presence fully stops the mic stream.
mute_file = "~/.secptile/assistant-mute"
